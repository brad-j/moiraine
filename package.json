{
  "name": "moiraine",
  "version": "0.0.0",
  "description": "The app for gaidin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "scripts": {
    "dev": "vite dev",
    "dev:faux": "node --no-warnings scripts/dev-faux.ts",
    "build": "vite build",
    "check": "vite build && tsc && pnpm lint && pnpm test",
    "lint": "oxlint --deny-warnings src scripts test e2e vite.config.ts playwright.config.ts",
    "test": "node --no-warnings --test test/*.test.ts",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-start": "^1.168.61",
    "@tanstack/react-virtual": "^3.14.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "gaidin": "link:../gaidin",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
